#!/usr/bin/env bash
# Mock systemctl with real active/inactive state, tracked via a marker file.
#
#   stop       → services inactive (marker removed)
#   start      → services active (marker created), unless:
#                  MOCK_FAIL_START points at an existing file → fail once
#                  MOCK_CRASH_AFTER_START is set → exit 0 but stay inactive
#                  (simulates a service that dies right after starting)
#   is-active  → exit 0 iff the marker exists
#   mask/unmask→ per-unit marker files; is-enabled prints "masked" while set.
#                MOCK_MASK_FAIL makes mask a silent no-op so the tool's
#                verify-the-mask path can be exercised.
#                MOCK_PREMASKED lists units that are already masked at start.
echo "systemctl $*" >> "${MOCK_LOG:-/dev/null}"
MARKER="${MOCK_LOG:-/tmp/mock-systemctl}.active"
MASKDIR="${MOCK_LOG:-/tmp/mock-systemctl}.masked.d"

_premask_seed() {
  [[ -n "${MOCK_PREMASKED:-}" ]] || return 0
  mkdir -p "$MASKDIR"
  local u
  for u in $MOCK_PREMASKED; do touch "$MASKDIR/$u"; done
}
_premask_seed

case "${1:-}" in
  show)
    # show --property=NAME --value UNIT. FragmentPath answers with the unit
    # file location: MOCK_UNIT_DIR overrides the /lib default, and a unit
    # named in MOCK_MISSING_UNIT is not found (empty, exit 0, like systemd).
    [[ -n "${MOCK_QUERY_FAIL:-}" ]] && exit 1
    prop="" unit=""
    for a in "${@:2}"; do
      case "$a" in
        --property=*) prop="${a#--property=}" ;;
        --*) ;;
        *) unit="$a" ;;
      esac
    done
    if [[ "$prop" == "FragmentPath" ]]; then
      [[ " ${MOCK_MISSING_UNIT:-} " == *" $unit "* ]] && { echo; exit 0; }
      echo "${MOCK_UNIT_DIR:-/lib/systemd/system}/$unit.service"
      exit 0
    fi
    [[ -f "$MARKER" ]] && echo active || echo inactive
    exit 0 ;;
  mask)
    [[ -n "${MOCK_MASK_FAIL:-}" ]] && exit 0
    mkdir -p "$MASKDIR"; shift
    for u in "$@"; do [[ "$u" == --* ]] || touch "$MASKDIR/$u"; done
    exit 0 ;;
  unmask)
    shift
    for u in "$@"; do [[ "$u" == --* ]] || rm -f "$MASKDIR/$u"; done
    exit 0 ;;
  is-enabled)
    shift
    for u in "$@"; do
      [[ "$u" == --* ]] && continue
      if [[ -f "$MASKDIR/$u" ]]; then echo masked; exit 0; fi
      echo enabled; exit 0
    done
    exit 1 ;;
  start)
    # A masked unit cannot be started, exactly like the real thing.
    for u in "${@:2}"; do
      [[ "$u" == --* ]] && continue
      if [[ -f "$MASKDIR/$u" ]]; then
        echo "Failed to start $u: Unit $u is masked." >&2
        exit 1
      fi
    done
    ;;&
  stop)
    [[ -n "${MOCK_STOP_FAIL:-}" ]] && exit 1
    # MOCK_STOP_SLEEP delays the stop, for the deadline test.
    [[ -n "${MOCK_STOP_SLEEP:-}" ]] && sleep "$MOCK_STOP_SLEEP"
    rm -f "$MARKER"
    exit 0 ;;
  start)
    if [[ -n "${MOCK_FAIL_START:-}" && -f "$MOCK_FAIL_START" ]]; then
      rm -f "$MOCK_FAIL_START"
      echo "mock systemctl: start failed" >&2
      exit 1
    fi
    if [[ -z "${MOCK_CRASH_AFTER_START:-}" ]]; then
      touch "$MARKER"
    fi
    exit 0 ;;
  is-active)
    for u in "${@:2}"; do
      [[ "$u" == --* ]] && continue
      [[ -f "$MASKDIR/$u" ]] && exit 3
    done
    [[ -f "$MARKER" ]] && exit 0 || exit 3 ;;
  *)
    exit 0 ;;
esac
